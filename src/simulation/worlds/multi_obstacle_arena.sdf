<?xml version="1.0"?>
<sdf version="1.9">
  <world name="multi_obstacle_arena">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary: 14m (x) x 10m (y) arena, wall thickness 0.2m, height 1.0m -->
    <model name="wall_west">
      <static>true</static>
      <pose>-7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Interior divider: splits the arena into a south "start" room (y < 2) and a
         north "goal" room (y > 2), connected by a single 1.6m-wide corridor centered
         at x=0, y=2. Keep the numbers below in sync with simulation_manager's
         corridor_band_* / corridor_half_width parameters in config/simulation_params.yaml
         -- they are hand-duplicated (SDF has no shared-value mechanism with a Python
         node's parameters), not derived, so editing one without the other will make
         the random-obstacle sampler think a wall gap exists where SDF has a wall, or
         vice versa. -->
    <model name="divider_west">
      <static>true</static>
      <pose>-3.85 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.1 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.1 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="divider_east">
      <static>true</static>
      <pose>3.85 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.1 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.1 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
