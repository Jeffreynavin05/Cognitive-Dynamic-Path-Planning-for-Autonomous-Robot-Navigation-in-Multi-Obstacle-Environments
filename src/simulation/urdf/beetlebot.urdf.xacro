<?xml version="1.0"?>
<robot name="beetlebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions sourced from BeetleBot hardware docs (docs.veerobot.com/ros-robots/beetle-bot,
       checked 2026-07-26). Wheel/sensor mount placements below are reasonable placements
       within the documented chassis footprint, not exact factory coordinates -- swap in the
       official URDF if/when one becomes available. -->

  <xacro:property name="chassis_length" value="0.375"/>
  <xacro:property name="chassis_width" value="0.36"/>
  <xacro:property name="chassis_height" value="0.245"/>
  <xacro:property name="chassis_mass" value="1.8"/>

  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="track_width" value="0.32"/>
  <xacro:property name="wheel_base" value="0.28"/>

  <material name="chassis_grey"><color rgba="0.25 0.25 0.28 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <inertia
        ixx="${chassis_mass/12.0*(chassis_width*chassis_width+chassis_height*chassis_height)}" ixy="0" ixz="0"
        iyy="${chassis_mass/12.0*(chassis_length*chassis_length+chassis_height*chassis_height)}" iyz="0"
        izz="${chassis_mass/12.0*(chassis_length*chassis_length+chassis_width*chassis_width)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00021"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect*wheel_base/2} ${y_reflect*track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- Sensors: frame placement and topic names mirror the real BeetleBot exactly so
       nodes built against this simulation need no topic remapping in Phase 2. -->

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height + 0.03}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.02 0.05 0.02"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><box size="0.02 0.05 0.02"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2 + 0.01} 0 ${chassis_height - 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- Optical-convention child frame (z-forward, x-right) so image_geometry / RViz camera
       overlays behave correctly; kept separate from camera_link's URDF-convention (x-forward)
       frame rather than fighting the two conventions in one frame. -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="imu_link">
    <visual><geometry><box size="0.01 0.01 0.005"/></geometry></visual>
    <collision><geometry><box size="0.01 0.01 0.005"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Harmonic plugins. Real BeetleBot is 4WD with no steering mechanism (4
       independent DRV8874-driven motors), so this is modeled as skid-steer: DiffDrive
       accepts multiple joints per side, which is exactly that. -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>wheel/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>tf</tf_topic>
      <publish_tf>true</publish_tf>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="rplidar_c1" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="pi_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>pi_camera/image_raw</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>30.0</far></clip>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
